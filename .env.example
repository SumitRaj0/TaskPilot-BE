PORT=5000
NODE_ENV=development

# MongoDB Atlas — use the full host from Atlas Connect (e.g. cluster0.xxxxx.mongodb.net)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/taskpilot?retryWrites=true&w=majority

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# OpenAI only (gpt-4o-mini). Get your key: https://platform.openai.com/api-keys
# Billing/credits required. Auth & tasks work without this; AI endpoints need it.
OPENAI_API_KEY=sk-your-openai-api-key

# Comma-separated frontend URLs (Vercel + local dev)
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
